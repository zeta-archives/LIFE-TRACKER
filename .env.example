# Aether — Public Frontend Environment Variables
# These values are exposed to the browser bundle via Vite.
# NEVER place service_role keys, secret keys, or database passwords in this file or any .env file.
# Copy this file to .env.local to configure your local development connection.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
